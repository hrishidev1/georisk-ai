# ===========================
# Application
# ===========================

PROJECT_NAME=GeoRisk AI
API_VERSION=0.1.0
APP_ENV=local
DEBUG=true

# ===========================
# Database
# ===========================

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=georisk
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ===========================
# Security
# ===========================

JWT_SECRET_KEY=replace-this-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ===========================
# Logging
# ===========================

LOG_LEVEL=DEBUG
LOG_JSON=false